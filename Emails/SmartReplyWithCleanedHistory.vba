' Outlook VBA macro for email replies that:
' a) sets the format to HTML
' b) Removes the mail header in the original message, except for the From: and Sent: lines
' c) Removes all the signature boilerplate text from the original sender (20+ lines of bumpf that nobody reads and is often longer than the content!)
' d) Removes any previous message in the thread more than 3 levels deep. (We don't need so much conext!)
' e) other "sanity improving" ideas

Option Explicit

' Main procedure to be called
Public Sub SmartReplyWithCleanedHistory()
    Dim oOriginalMail As Outlook.MailItem
    Dim oReply As Outlook.MailItem
    Dim sOriginalHTMLBody As String
    Dim sProcessedHTMLBody As String
    Dim Inspector As Outlook.Inspector

    On Error GoTo ErrorHandler

    ' Get the current item (either selected in explorer or open in an inspector)
    Set Inspector = Application.ActiveInspector
    If Not Inspector Is Nothing Then
        If TypeOf Inspector.CurrentItem Is Outlook.MailItem Then
            Set oOriginalMail = Inspector.CurrentItem
        End If
    Else
        If Application.ActiveExplorer.Selection.Count > 0 Then
            If TypeOf Application.ActiveExplorer.Selection.Item(1) Is Outlook.MailItem Then
                Set oOriginalMail = Application.ActiveExplorer.Selection.Item(1)
            End If
        End If
    End If

    If oOriginalMail Is Nothing Then
        MsgBox "Please select or open an email to reply to.", vbInformation
        Exit Sub
    End If

    ' Create a reply object
    Set oReply = oOriginalMail.Reply ' Use .ReplyAll if you prefer

    ' a) Ensure reply format is HTML
    oReply.BodyFormat = olFormatHTML

    ' IMPORTANT: Display the reply, get HTMLBody, then close.
    ' This ensures HTMLBody is fully generated by Outlook before we modify it.
    oReply.Display
    sOriginalHTMLBody = oReply.HTMLBody
    oReply.Close olDiscard ' Close the initial, unmodified reply window

    ' Start processing the HTML Body
    sProcessedHTMLBody = sOriginalHTMLBody

    ' b) Clean the header of the immediate original message
    sProcessedHTMLBody = CleanFirstMessageHeader(sProcessedHTMLBody)

    ' c) Remove signature from the immediate original message
    sProcessedHTMLBody = RemoveSignatureFromFirstMessage(sProcessedHTMLBody)

    ' d) Limit conversation history depth (keep 3 previous messages)
    ' This means the message being replied to, and two before it.
    sProcessedHTMLBody = LimitThreadDepth(sProcessedHTMLBody, 3)

    ' e) Other sanity improvements
    sProcessedHTMLBody = RemoveExcessiveLineBreaks(sProcessedHTMLBody)
    sProcessedHTMLBody = RemoveWordSpecificHTML(sProcessedHTMLBody)

    ' Set the modified HTML body back to the reply object
    oReply.HTMLBody = sProcessedHTMLBody

    ' Display the cleaned reply for the user to review and send
    oReply.Display

    ' Clean up
    Set oOriginalMail = Nothing
    Set oReply = Nothing
    Set Inspector = Nothing
    Exit Sub

ErrorHandler:
    MsgBox "Error " & Err.Number & ": " & Err.Description, vbCritical, "Macro Error"
    ' Clean up
    Set oOriginalMail = Nothing
    Set oReply = Nothing
    Set Inspector = Nothing
End Sub

' Helper Function to clean the header of the first message in the reply body
Private Function CleanFirstMessageHeader(htmlBody As String) As String
    Dim re As Object
    Dim firstHeaderMatch As Object
    Dim hrTag As String, fromLine As String, sentLine As String
    Dim headerContentBeforeSubject As String
    Dim fullMatchedHeaderBlock As String
    Dim contentAfterFullHeader As String

    On Error Resume Next ' Regex can be tricky
    Set re = CreateObject("VBScript.RegExp")
    re.IgnoreCase = True
    re.Global = False ' Only target the first header block

    ' This pattern tries to find the typical Outlook header block for the first replied message.
    ' It captures: <hr>, content between <hr> and "Subject:", the "Subject:" line, and the <br> or <p> after it.
    re.Pattern = "(<hr[^>]*>)([\s\S]*?)(<b>From:<\/b>[\s\S]*?<br>)([\s\S]*?)(<b>Sent:<\/b>[\s\S]*?<br>)([\s\S]*?)(<b>Subject:<\/b>[\s\S]*?<br>\s*(?:<br>|<p[^>]*>))"

    If re.Test(htmlBody) Then
        Set firstHeaderMatch = re.Execute(htmlBody)(0)
        fullMatchedHeaderBlock = firstHeaderMatch.Value ' The entire matched header block
        
        hrTag = firstHeaderMatch.SubMatches(0) ' The <hr ...> tag

        ' Extract From: line (SubMatch 2 because index is 0-based, pattern group 3)
        Dim tempRe As Object
        Set tempRe = CreateObject("VBScript.RegExp")
        tempRe.IgnoreCase = True
        tempRe.Pattern = "(<b>From:<\/b>[\s\S]*?<br>)"
        If tempRe.Test(fullMatchedHeaderBlock) Then fromLine = tempRe.Execute(fullMatchedHeaderBlock)(0).Value
        
        ' Extract Sent: line
        tempRe.Pattern = "(<b>Sent:<\/b>[\s\S]*?<br>)"
        If tempRe.Test(fullMatchedHeaderBlock) Then sentLine = tempRe.Execute(fullMatchedHeaderBlock)(0).Value

        ' Reconstruct the cleaned header
        Dim cleanedHeader As String
        cleanedHeader = hrTag
        If fromLine <> "" Then cleanedHeader = cleanedHeader & fromLine
        If sentLine <> "" Then cleanedHeader = cleanedHeader & sentLine
        cleanedHeader = cleanedHeader & "<br>" ' Add a blank line for separation

        ' Replace the original full header block with the cleaned one
        CleanFirstMessageHeader = Left(htmlBody, firstHeaderMatch.FirstIndex) & _
                                  cleanedHeader & _
                                  Mid(htmlBody, firstHeaderMatch.FirstIndex + Len(fullMatchedHeaderBlock))
    Else
        ' Pattern didn't match, return original body
        CleanFirstMessageHeader = htmlBody
    End If
    If Err.Number <> 0 Then CleanFirstMessageHeader = htmlBody ' Fallback on error
End Function

' Helper Function to remove signature from the first message in the reply body
Private Function RemoveSignatureFromFirstMessage(htmlBody As String) As String
    Dim re As Object, reSig As Object
    Dim firstHeaderEndMarker As Object
    Dim bodyAfterFirstHeaderStart As Long
    Dim contentOfFirstMessage As String
    Dim contentAfterFirstMessageBlock As String
    Dim nextHrMatch As Object
    Dim sigFoundAt As Long: sigFoundAt = -1
    Dim p As Variant

    On Error Resume Next
    Set re = CreateObject("VBScript.RegExp")
    re.IgnoreCase = True
    re.Global = False

    Set reSig = CreateObject("VBScript.RegExp")
    reSig.IgnoreCase = True
    reSig.MultiLine = True ' Some signature patterns might span what regex considers lines

    ' Marker for the end of the (cleaned or original) first header.
    ' This assumes the header cleaning already happened or we find a similar structure.
    re.Pattern = "(<hr[^>]*>(?:<b>From:<\/b>[\s\S]*?<br>)?(?:<b>Sent:<\/b>[\s\S]*?<br>)?\s*<br>)"
    If Not re.Test(htmlBody) Then
        ' Fallback if cleaned header pattern not found, try original subject line end
         re.Pattern = "(<hr[^>]*>[\s\S]*?<b>Subject:<\/b>[\s\S]*?<br>\s*(?:<br>|<p[^>]*>))"
    End If

    If re.Test(htmlBody) Then
        Set firstHeaderEndMarker = re.Execute(htmlBody)(0)
        bodyAfterFirstHeaderStart = firstHeaderEndMarker.FirstIndex + Len(firstHeaderEndMarker.Value)
        
        Dim firstMessageAndRestOfThread As String
        firstMessageAndRestOfThread = Mid(htmlBody, bodyAfterFirstHeaderStart)

        ' Isolate the content of the first message (up to the next <hr> or end of string)
        re.Pattern = "<hr[^>]*>" ' Look for the next <hr>
        If re.Test(firstMessageAndRestOfThread) Then
            Set nextHrMatch = re.Execute(firstMessageAndRestOfThread)(0)
            contentOfFirstMessage = Left(firstMessageAndRestOfThread, nextHrMatch.FirstIndex)
            contentAfterFirstMessageBlock = Mid(firstMessageAndRestOfThread, nextHrMatch.FirstIndex)
        Else
            contentOfFirstMessage = firstMessageAndRestOfThread
            contentAfterFirstMessageBlock = ""
        End If

        ' Common signature starting phrases/patterns
        Dim signaturePatterns As Variant
        signaturePatterns = Array( _
            "<p[^>]*>\s*--\s*(&nbsp;)?\s*<\/p>", "<div>\s*--\s*(&nbsp;)?\s*<\/div>", "--\s*<br>", _
            "Regards,?", "Sincerely,?", "Best regards,?", "Kind regards,?", "Thanks,?", "Cheers,?", _
            "Best,?", "Warm regards,?", _
            "Sent from my iPhone", "Sent from my Android", _
            "Confidentiality Notice:", "Legal Disclaimer:", "Privacy Statement:", _
            "<div[^>]*id\s*=\s*['""]signature['""]", "<div[^>]*class\s*=\s*['""]signature['""]" _
        )
        
        ' More generic pattern for typical signature blocks (often many small lines)
        ' This looks for a block of text with at least 3 <br> tags in close succession,
        ' or multiple <p> tags, often with links or phone numbers.
        ' This is a more aggressive and potentially risky pattern.
        ' For now, we focus on the text separators.

        Dim tempContent As String: tempContent = contentOfFirstMessage
        Dim matchPos As Long
        
        For Each p In signaturePatterns
            reSig.Pattern = p & "[\s\S]*" ' Match the pattern and everything after it within this block
            If reSig.Test(tempContent) Then
                matchPos = reSig.Execute(tempContent)(0).FirstIndex
                If sigFoundAt = -1 Or matchPos < sigFoundAt Then
                    ' Heuristic: If signature is very early, maybe it's not a signature.
                    ' Only apply if it's not in the first 20% of the message block,
                    ' unless the block itself is very short.
                    If Len(tempContent) < 200 Or matchPos > (Len(tempContent) * 0.2) Then
                         sigFoundAt = matchPos
                    End If
                End If
            End If
        Next

        If sigFoundAt <> -1 Then
            ' Check if we are removing a very large portion, which might be an error
            If Len(Left(tempContent, sigFoundAt)) > 50 Then ' Keep if at least 50 chars before signature
                contentOfFirstMessage = Left(tempContent, sigFoundAt)
            End If
        End If
        
        ' Reconstruct the body
        RemoveSignatureFromFirstMessage = Left(htmlBody, bodyAfterFirstHeaderStart - 1) & _
                                          contentOfFirstMessage & _
                                          contentAfterFirstMessageBlock
    Else
        RemoveSignatureFromFirstMessage = htmlBody ' Could not identify first message block
    End If
    If Err.Number <> 0 Then RemoveSignatureFromFirstMessage = htmlBody ' Fallback
End Function

' Helper Function to limit the depth of the email thread
Private Function LimitThreadDepth(htmlBody As String, maxMessagesToKeep As Integer) As String
    Dim re As Object
    Dim matches As Object
    Dim i As Integer
    Dim lastKeptHrIndex As Long

    On Error Resume Next
    Set re = CreateObject("VBScript.RegExp")
    re.Pattern = "<hr[^>]*>" ' Standard Outlook message separator
    re.IgnoreCase = True
    re.Global = True

    Set matches = re.Execute(htmlBody)

    ' If we have more HR tags than messages we want to keep.
    ' maxMessagesToKeep = 3 means we keep the message being replied to (1st HR),
    ' the one before it (2nd HR), and the one before that (3rd HR).
    ' So, we cut *at* the (maxMessagesToKeep)-th HR's position.
    ' No, we cut AT the (maxMessagesToKeep)-th HR's position if we count HRs.
    ' If maxMessagesToKeep is 3, we want to find the 3rd HR. The content after it up to the 4th HR is the 3rd message.
    ' We want to cut at the start of the (maxMessagesToKeep + 1)-th message, which is AT the (maxMessagesToKeep)-th HR tag.
    ' Example: maxMessagesToKeep = 1. Keep 1 message. Cut at matches(1).FirstIndex.
    ' matches(0) is HR before message 1.
    ' matches(1) is HR before message 2.
    ' To keep 1 message, we need content up to matches(1).FirstIndex.
    ' So, if matches.Count > maxMessagesToKeep, we truncate at matches(maxMessagesToKeep).FirstIndex
    
    If matches.Count > maxMessagesToKeep Then
        LimitThreadDepth = Left(htmlBody, matches(maxMessagesToKeep).FirstIndex)
    Else
        LimitThreadDepth = htmlBody ' Not enough messages to truncate
    End If
    If Err.Number <> 0 Then LimitThreadDepth = htmlBody
End Function

' Helper Function to remove excessive line breaks
Private Function RemoveExcessiveLineBreaks(htmlBody As String) As String
    Dim re As Object
    Dim tempBody As String

    On Error Resume Next
    Set re = CreateObject("VBScript.RegExp")
    re.Global = True
    re.IgnoreCase = True
    tempBody = htmlBody

    ' Collapse multiple <br> tags (and variants like <br />, <BR>) into one
    re.Pattern = "(<br\s*/?>\s*){2,}"
    tempBody = re.Replace(tempBody, "<br>")

    ' Collapse multiple empty paragraphs <p>&nbsp;</p> or <p></p> into one
    re.Pattern = "(<p[^>]*>\s*(&nbsp;)?\s*<\/p>\s*){2,}"
    tempBody = re.Replace(tempBody, "<p>&nbsp;</p>") ' Or use "<p><br></p>" for visual space

    RemoveExcessiveLineBreaks = tempBody
    If Err.Number <> 0 Then RemoveExcessiveLineBreaks = htmlBody
End Function

' Helper Function to remove Word-specific HTML comments and tags
Private Function RemoveWordSpecificHTML(htmlBody As String) As String
    Dim re As Object
    Dim tempBody As String

    On Error Resume Next
    Set re = CreateObject("VBScript.RegExp")
    re.Global = True
    re.IgnoreCase = True
    re.MultiLine = True ' For <!--[if ...]> ... <![endif]--> blocks
    tempBody = htmlBody

    ' Remove <!--[if gte mso 9]>...<![endif]--> conditional comments
    re.Pattern = "<!--\[if\s(?:gte\s|lte\s)?mso\s\d+\]>[\s\S]*?<!\[endif\]-->"
    tempBody = re.Replace(tempBody, "")

    ' Remove <o:p></o:p> tags (often empty paragraphs from Word)
    re.Pattern = "<\/?o:p>" ' Matches <o:p> and </o:p>
    tempBody = re.Replace(tempBody, "")
    
    ' Remove XML namespace declarations (e.g., xmlns:o="...") from tags if they cause issues
    ' This is more complex and generally not needed unless specific problems arise.

    RemoveWordSpecificHTML = tempBody
    If Err.Number <> 0 Then RemoveWordSpecificHTML = htmlBody
End Function
